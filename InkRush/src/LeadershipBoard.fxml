<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-border-width: 8; -fx-background-color: #0000;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
   <children>
      <VBox alignment="CENTER" layoutX="175.0" layoutY="41.0" prefHeight="390.0" prefWidth="251.0" style="-fx-background-color: #1E90FF;">
         <children>
            <Label alignment="CENTER" prefHeight="36.0" prefWidth="185.0" text="GAME OVER!">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <font>
                  <Font name="Andale Mono" size="30.0" />
               </font>
            </Label>
            <Label text="🏆 WINNER:🏆" textFill="#ffb84d">
               <font>
                  <Font name="Andale Mono" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Label>
            <Label fx:id="winnerNameLabel" text="username" textFill="#ffb84d">
               <font>
                  <Font name="Andale Mono" size="14.0" />
               </font>
            </Label>
            <Label prefHeight="10.0" prefWidth="235.0" text="══════════════════════════════" textFill="#99a847">
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
            </Label>
            <HBox prefHeight="80.0" prefWidth="140.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="80.0" prefWidth="284.0">
                     <children>
                        <Label prefHeight="26.0" prefWidth="24.0" text="🥇">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </HBox>
            <Button fx:id="restartGameButton" mnemonicParsing="false" prefHeight="61.0" prefWidth="97.0" text="Restart Game" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</AnchorPane>
